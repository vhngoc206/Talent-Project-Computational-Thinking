# Sao chép file này thành .env rồi điền key (KHÔNG commit file .env).
# Các key này CHỈ được đọc ở phía server (/api/...), không bao giờ nằm trong JS của trình duyệt.
# Khi deploy lên Vercel: khai báo đúng các biến này trong Project Settings → Environment Variables.

# Gemini – lấy key miễn phí tại https://aistudio.google.com/apikey
# Để trống => ứng dụng chạy Demo Mode (câu trả lời bằng logic có sẵn, không gọi AI).
GEMINI_API_KEY=

# Tùy chọn: tên model Gemini. Mặc định: gemini-flash-latest.
# GEMINI_MODEL=gemini-flash-latest

# Tùy chọn: YouTube Data API v3 key để TÌM KIẾM nhạc trong trang Focus.
# Không có key vẫn phát được nhạc bằng cách dán link YouTube.
# Tạo tại https://console.cloud.google.com/apis/library/youtube.googleapis.com → Credentials → API key
YOUTUBE_API_KEY=

# Đăng nhập + lưu dữ liệu theo tài khoản (Firebase). Lấy ở Firebase Console → Project settings → Your apps → Web app.
# Đây là cấu hình công khai của Firebase (không phải mật khẩu). Để trống => chạy cục bộ, không cần đăng nhập.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
